{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Floating Todo",
  "version": "0.1.0",
  "identifier": "app.floatingtodo.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Floating Todo",
        "width": 340,
        "height": 460,
        "minWidth": 280,
        "minHeight": 96,
        "maxWidth": 560,
        "maxHeight": 900,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "deb"],
    "publisher": "Floating Todo",
    "copyright": "MIT licensed",
    "category": "Productivity",
    "shortDescription": "Always-on-top task and reminder widget",
    "longDescription": "A compact floating desktop panel for tasks with deadlines, countdowns and audible reminders. All data stays on this computer.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": { "installMode": "currentUser" },
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
